#!/bin/bash
# Health probe for embassy in images without curl (the Docker Compose healthcheck):
#   attache-http-ready [port] [path]        default: 8080 /api/v1/readyz
# Sends GET to 127.0.0.1:<port><path> with `Host: localhost`, which embassy's Host check always
# admits, and exits 0 only on HTTP 200. Kubernetes probes use httpGet with the same header instead.
set -euo pipefail
port=${1:-8080}
path=${2:-/api/v1/readyz}
[[ $port =~ ^[0-9]{1,5}$ && $path == /* ]] || { echo "usage: attache-http-ready [port] [/path]" >&2; exit 2; }
exec 3<>"/dev/tcp/127.0.0.1/$port"
printf 'GET %s HTTP/1.1\r\nHost: localhost\r\nConnection: close\r\n\r\n' "$path" >&3
IFS= read -r -t 5 status <&3 || exit 1
[[ $status =~ ^HTTP/1\.[01]\ 200[[:space:]] ]]
