{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "agent-sidecar chart values",
  "type": "object",
  "additionalProperties": false,
  "definitions": {
    "dnsLabel": {
      "type": "string",
      "pattern": "^[a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?$"
    },
    "dnsName": {
      "type": "string",
      "pattern": "^[a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?)*$",
      "maxLength": 253
    },
    "sha256": {
      "type": "string",
      "description": "Lowercase hex SHA-256 of the token text; the token itself never goes into values.",
      "pattern": "^[0-9a-f]{64}$"
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string" },
        "digest": { "type": "string", "pattern": "^(sha256:[0-9a-f]{64})?$" },
        "pullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] }
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requests": { "type": "object" },
        "limits": { "type": "object" },
        "claims": { "type": "array" }
      }
    }
  },
  "properties": {
    "global": { "type": "object" },
    "images": {
      "type": "object",
      "additionalProperties": false,
      "required": ["embassy", "agentscd"],
      "properties": {
        "embassy": { "$ref": "#/definitions/image" },
        "agentscd": { "$ref": "#/definitions/image" }
      }
    },
    "imagePullSecrets": { "type": "array" },
    "clusterDomain": { "$ref": "#/definitions/dnsName" },
    "crds": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "install": { "type": "boolean" } }
    },
    "auth": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tokens": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "role", "sha256"],
            "properties": {
              "name": { "$ref": "#/definitions/dnsLabel" },
              "role": { "type": "string", "enum": ["viewer", "editor", "admin"] },
              "sha256": { "$ref": "#/definitions/sha256" },
              "namespaces": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^(\\*|[a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?)$"
                }
              },
              "payloads": { "type": "boolean" }
            }
          }
        },
        "sessionKey": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "existingSecret": {
              "type": "string",
              "pattern": "^([a-z0-9]([-.a-z0-9]{0,251}[a-z0-9])?)?$"
            }
          }
        }
      }
    },
    "issuance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kubernetes": { "type": "boolean" },
        "workloadCertTTL": { "type": "string", "pattern": "^([0-9]+[dhms])+$" },
        "joinTokens": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "sha256", "namespace", "services", "expires_at"],
            "properties": {
              "name": { "$ref": "#/definitions/dnsLabel" },
              "sha256": { "$ref": "#/definitions/sha256" },
              "namespace": { "$ref": "#/definitions/dnsLabel" },
              "services": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": { "$ref": "#/definitions/dnsLabel" }
              },
              "expires_at": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "require_authz_default_deny": { "type": "boolean" },
        "http_origin_allowlist": { "type": "array", "items": { "type": "string" } },
        "forbid_learning_auto": { "type": "boolean" }
      }
    },
    "events": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "retainBytes": { "type": "integer", "minimum": 1048576, "maximum": 17179869184 }
      }
    },
    "ca": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "existingSecret": {
          "type": "string",
          "description": "<namespace>/<name> of an existing CA Secret, or empty.",
          "pattern": "^([a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?/[a-z0-9]([-.a-z0-9]{0,251}[a-z0-9])?)?$"
        }
      }
    },
    "otlp": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "endpoint": { "type": "string", "pattern": "^(https?://[^\\s/?#]+/?)?$" },
        "endpointAllow": {
          "type": "array",
          "items": { "type": "string", "minLength": 1, "pattern": "^[^,\\s]+$" }
        }
      }
    },
    "injection": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "failurePolicy": { "type": "string", "enum": ["Fail", "Ignore"] },
        "allowedImageDigests": {
          "type": "array",
          "description": "Digests of signed sidecar images (ControlPlaneConfig sidecar_images.allowed_digests), besides images.agentscd.digest.",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
        },
        "mockFallback": { "type": "boolean" },
        "resources": { "$ref": "#/definitions/resources" },
        "securityContext": { "type": "object" }
      }
    },
    "embassyCa": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "replicas": { "type": "integer", "minimum": 1 },
        "podDisruptionBudget": {
          "type": "object",
          "additionalProperties": false,
          "properties": { "minAvailable": { "type": ["integer", "string"] } }
        },
        "antiAffinity": { "type": "string", "enum": ["soft", "hard"] },
        "resources": { "$ref": "#/definitions/resources" },
        "dnsNames": { "type": "array", "items": { "$ref": "#/definitions/dnsName" } },
        "podAnnotations": { "type": "object" },
        "nodeSelector": { "type": "object" },
        "tolerations": { "type": "array" },
        "logLevel": { "type": "string", "minLength": 1 }
      }
    },
    "embassy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "resources": { "$ref": "#/definitions/resources" },
        "httpTLS": { "type": "boolean" },
        "http3": { "type": "boolean" },
        "dnsNames": { "type": "array", "items": { "$ref": "#/definitions/dnsName" } },
        "service": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": { "type": "string", "enum": ["ClusterIP", "NodePort", "LoadBalancer"] }
          }
        },
        "podAnnotations": { "type": "object" },
        "nodeSelector": { "type": "object" },
        "tolerations": { "type": "array" },
        "affinity": { "type": "object" },
        "logLevel": { "type": "string", "minLength": 1 }
      }
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "httpFrom": { "type": "array", "items": { "type": "object" } }
      }
    },
    "rbac": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "aggregate": { "type": "boolean" },
        "charterEditAggregatesTo": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "enum": ["admin", "edit"] }
        }
      }
    },
    "podSecurityContext": { "type": "object" },
    "securityContext": { "type": "object" }
  }
}
