{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "apiVersion": {
      "type": "string"
    },
    "kind": {
      "type": "string"
    },
    "service": {
      "$ref": "#/$defs/ServiceSpec"
    },
    "mesh": {
      "$ref": "#/$defs/MeshSpec",
      "default": {
        "port": 50002,
        "peers": {}
      }
    },
    "skills": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/SkillSpec"
      },
      "description": "Skills agents can use (`agents[].skills`), by name.",
      "maxItems": 64
    },
    "agents": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/AgentSpec"
      },
      "default": []
    },
    "guardrails": {
      "$ref": "#/$defs/Guardrails",
      "default": {
        "max_input_bytes": 16384,
        "pii_redact": false,
        "input_deny": [],
        "output_deny": [],
        "allowed_tools": {},
        "allowed_services": {}
      }
    },
    "authz": {
      "$ref": "#/$defs/Authz",
      "default": {
        "default": "deny",
        "callers": [],
        "services": []
      }
    },
    "audit": {
      "$ref": "#/$defs/AuditSpec",
      "default": {
        "sink": "stdout",
        "redact": []
      }
    },
    "telemetry": {
      "anyOf": [
        {
          "$ref": "#/$defs/TelemetrySpec"
        },
        {
          "type": "null"
        }
      ],
      "description": "OpenTelemetry export and what audit leaves the pod. Absent = the defaults."
    }
  },
  "required": [
    "apiVersion",
    "kind",
    "service"
  ],
  "title": "attache Charter (attache.io/v1alpha1)",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "ServiceSpec": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "description": "DNS-1123 label; also the `svc/<name>` segment of the pod's SPIFFE ID."
        },
        "namespace": {
          "type": "string"
        },
        "app_port": {
          "type": "integer",
          "format": "uint16",
          "minimum": 0,
          "maximum": 65535,
          "description": "Port the app container listens on (localhost), target of inbound service invocations."
        },
        "service_accounts": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?$"
          },
          "description": "Kubernetes service accounts whose pods may obtain this identity, besides `<service.name>`\n(default: `[<service.name>]`)."
        }
      },
      "required": [
        "name",
        "namespace",
        "app_port"
      ]
    },
    "MeshSpec": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "port": {
          "type": "integer",
          "format": "uint16",
          "minimum": 0,
          "maximum": 65535,
          "default": 50002
        },
        "peers": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "description": "service name → `host:port` override of `<service>.<namespace>.svc.cluster.local:50002`.",
          "default": {}
        }
      }
    },
    "SkillSpec": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "description": "DNS-1123 label, unique among skills.",
          "pattern": "^[a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?$"
        },
        "description": {
          "type": "string",
          "description": "What the skill is for (1 to 1024 characters); the model sees it before it loads the skill.",
          "minLength": 1,
          "maxLength": 1024
        },
        "instructions": {
          "type": "string",
          "description": "What the agent should do (1 to 32768 bytes).",
          "minLength": 1,
          "maxLength": 32768
        },
        "tools": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Tools the instructions use; each must be allowed for every agent that uses the skill."
        }
      },
      "required": [
        "name",
        "description",
        "instructions"
      ],
      "description": "A named set of instructions agents can use (`agents[].skills`)."
    },
    "AgentSpec": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "type": {
          "$ref": "#/$defs/AgentType",
          "default": "agent"
        },
        "model": {
          "type": "string",
          "description": "A Claude model id (e.g. `claude-opus-5-5`) or `mock`."
        },
        "system": {
          "type": "string",
          "description": "System prompt, at most 32768 bytes.",
          "maxLength": 32768,
          "default": ""
        },
        "tools": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ToolSpec"
          },
          "default": []
        },
        "budgets": {
          "$ref": "#/$defs/Budgets",
          "default": {
            "max_tokens_per_call": 1024,
            "max_calls_per_minute": 60,
            "max_cost_usd_per_day": 10.0,
            "max_steps": 8
          }
        },
        "skills": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?$"
          },
          "description": "Names of top-level `skills` this agent uses, each at most once.",
          "uniqueItems": true
        },
        "harness": {
          "anyOf": [
            {
              "$ref": "#/$defs/HarnessSpec"
            },
            {
              "type": "null"
            }
          ],
          "description": "Retries, timeouts and the fallback model. Absent = the defaults."
        },
        "learning": {
          "anyOf": [
            {
              "$ref": "#/$defs/LearningSpec"
            },
            {
              "type": "null"
            }
          ],
          "description": "Governed learning. Absent = off."
        }
      },
      "required": [
        "name",
        "model"
      ]
    },
    "AgentType": {
      "type": "string",
      "enum": [
        "agent",
        "orchestrator"
      ]
    },
    "ToolSpec": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "type": {
          "$ref": "#/$defs/ToolType"
        },
        "parameters": {
          "description": "JSON Schema object describing the tool input. Defaults per CONTRACT.md §3.1."
        },
        "service": {
          "type": [
            "string",
            "null"
          ],
          "description": "`service` tools: target service. `agent` tools: remote service (omit for local)."
        },
        "method": {
          "type": [
            "string",
            "null"
          ]
        },
        "path": {
          "type": [
            "string",
            "null"
          ]
        },
        "agent": {
          "type": [
            "string",
            "null"
          ]
        },
        "url": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "name",
        "description",
        "type"
      ]
    },
    "ToolType": {
      "type": "string",
      "enum": [
        "service",
        "agent",
        "http"
      ]
    },
    "Budgets": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_tokens_per_call": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0,
          "default": 1024
        },
        "max_calls_per_minute": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0,
          "default": 60
        },
        "max_cost_usd_per_day": {
          "type": "number",
          "format": "double",
          "default": 10.0
        },
        "max_steps": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0,
          "default": 8
        }
      }
    },
    "HarnessSpec": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_retries": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0,
          "description": "Retries of a model call after a retryable failure, 0..=10.",
          "maximum": 10,
          "default": 2
        },
        "request_timeout_seconds": {
          "type": "integer",
          "format": "uint32",
          "minimum": 1,
          "description": "SDK timeout of each attempt, 1..=600 seconds.",
          "maximum": 600,
          "default": 120
        },
        "fallback_model": {
          "type": [
            "string",
            "null"
          ],
          "description": "Model tried once after the last retryable failure; a valid model id other than `model`."
        },
        "tool_result_max_chars": {
          "type": "integer",
          "format": "uint32",
          "minimum": 100,
          "description": "Tool results are cut to this many characters, 100..=200000.",
          "maximum": 200000,
          "default": 20000
        }
      },
      "description": "`agents[].harness`: how the runtime retries and bounds model and tool calls."
    },
    "LearningSpec": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": false
        },
        "mode": {
          "$ref": "#/$defs/LearningMode",
          "description": "`auto` requires `enabled: true`.",
          "default": "review"
        },
        "max_notes": {
          "type": "integer",
          "format": "uint32",
          "minimum": 1,
          "description": "Active notes kept for the agent, 1..=200.",
          "maximum": 200,
          "default": 20
        },
        "max_note_chars": {
          "type": "integer",
          "format": "uint32",
          "minimum": 50,
          "description": "Longest note, 50..=4000 characters.",
          "maximum": 4000,
          "default": 500
        },
        "note_ttl_days": {
          "type": "integer",
          "format": "uint32",
          "minimum": 1,
          "description": "Lifetime of an `auto` note, 1..=365 days.",
          "maximum": 365,
          "default": 7
        },
        "from_peers": {
          "type": "boolean",
          "description": "Also reflect on invocations whose caller is a peer service.",
          "default": false
        },
        "max_proposals_per_hour": {
          "type": "integer",
          "format": "uint32",
          "minimum": 1,
          "description": "Lessons the agent may propose per hour, 1..=100.",
          "maximum": 100,
          "default": 10
        }
      },
      "description": "`agents[].learning`: governed learning (design §4, §6.5).",
      "if": {
        "properties": {
          "mode": {
            "const": "auto"
          }
        },
        "required": [
          "mode"
        ]
      },
      "then": {
        "properties": {
          "enabled": {
            "const": true
          }
        },
        "required": [
          "enabled"
        ]
      }
    },
    "LearningMode": {
      "oneOf": [
        {
          "type": "string",
          "const": "review",
          "description": "A proposed lesson waits for an editor's decision."
        },
        {
          "type": "string",
          "const": "auto",
          "description": "A proposed lesson becomes a note at once and expires after `note_ttl_days`."
        }
      ]
    },
    "Guardrails": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_input_bytes": {
          "type": "integer",
          "format": "uint",
          "minimum": 0,
          "default": 16384
        },
        "pii_redact": {
          "type": "boolean",
          "default": false
        },
        "input_deny": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/RegexRule"
          },
          "default": []
        },
        "output_deny": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/RegexRule"
          },
          "default": []
        },
        "allowed_tools": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "description": "agent → tool names it may use (default: every tool it declares).",
          "default": {}
        },
        "allowed_services": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "description": "agent → services it may call (default: every service its tools name).",
          "default": {}
        }
      }
    },
    "RegexRule": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "regex": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "regex"
      ]
    },
    "Authz": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "default": {
          "$ref": "#/$defs/Decision",
          "default": "deny"
        },
        "callers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CallerRule"
          },
          "default": []
        },
        "services": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ServiceRule"
          },
          "default": []
        }
      }
    },
    "Decision": {
      "type": "string",
      "enum": [
        "allow",
        "deny"
      ]
    },
    "CallerRule": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "identity": {
          "type": "string",
          "description": "`local` (the app container) or a SPIFFE ID."
        },
        "agents": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Agent names, or `\"*\"`."
        },
        "caller_agents": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Calling agents (the `x-attache-agent` claim of the caller's sidecar) this rule admits.\nEmpty = any calling agent, including a direct call by the caller's app."
        }
      },
      "required": [
        "identity",
        "agents"
      ]
    },
    "ServiceRule": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "identity": {
          "type": [
            "string",
            "null"
          ]
        },
        "agent": {
          "type": [
            "string",
            "null"
          ]
        },
        "service": {
          "type": "string",
          "description": "Target service (this service's own name when evaluated inbound)."
        },
        "allow": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "`\"<METHOD|*> <path>\"`, optional trailing `*` on the path.",
          "default": []
        },
        "deny": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        }
      },
      "required": [
        "name",
        "service"
      ]
    },
    "AuditSpec": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sink": {
          "$ref": "#/$defs/AuditSink",
          "default": "stdout"
        },
        "file": {
          "type": [
            "string",
            "null"
          ]
        },
        "redact": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Dotted paths inside `input`/`output` replaced by \"[redacted]\".",
          "default": []
        }
      }
    },
    "AuditSink": {
      "type": "string",
      "enum": [
        "stdout",
        "file"
      ]
    },
    "TelemetrySpec": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "otlp_endpoint": {
          "type": [
            "string",
            "null"
          ],
          "description": "OTLP/HTTP endpoint, `http(s)://host[:port]` with no path, query or fragment. Honoured only\nwhen the sidecar allows it (`--otlp-endpoint-allow`); changing it needs a restart.",
          "pattern": "^https?://[^/?#@\\s]+/?$"
        },
        "traces": {
          "type": "boolean",
          "default": true
        },
        "metrics": {
          "type": "boolean",
          "default": true
        },
        "export_payloads": {
          "type": "boolean",
          "description": "Spans carry inputs and outputs only if true.",
          "default": false
        },
        "control_plane_payloads": {
          "type": "boolean",
          "description": "Audit records sent to the control plane keep their (redacted, truncated) input/output.",
          "default": true
        }
      },
      "description": "`telemetry` (design §4, §9)."
    }
  },
  "$id": "https://attache.io/schemas/v1alpha1/charter.schema.json"
}
