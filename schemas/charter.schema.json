{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "apiVersion": {
      "type": "string"
    },
    "kind": {
      "type": "string"
    },
    "service": {
      "$ref": "#/$defs/ServiceSpec"
    },
    "mesh": {
      "$ref": "#/$defs/MeshSpec",
      "default": {
        "port": 50002,
        "peers": {}
      }
    },
    "skills": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/SkillSpec"
      },
      "description": "Skills agents can use (`agents[].skills`), by name.",
      "maxItems": 64
    },
    "agents": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/AgentSpec"
      },
      "default": []
    },
    "guardrails": {
      "$ref": "#/$defs/Guardrails",
      "default": {
        "max_input_bytes": 16384,
        "pii_redact": false,
        "input_deny": [],
        "output_deny": [],
        "allowed_tools": {},
        "allowed_services": {}
      }
    },
    "authz": {
      "$ref": "#/$defs/Authz",
      "default": {
        "default": "deny",
        "callers": [],
        "services": []
      }
    },
    "audit": {
      "$ref": "#/$defs/AuditSpec",
      "default": {
        "sink": "stdout",
        "redact": []
      }
    },
    "telemetry": {
      "anyOf": [
        {
          "$ref": "#/$defs/TelemetrySpec"
        },
        {
          "type": "null"
        }
      ],
      "description": "OpenTelemetry export and what audit leaves the pod. Absent = the defaults."
    }
  },
  "required": [
    "apiVersion",
    "kind",
    "service"
  ],
  "title": "agentsc Charter (agentsc.io/v1alpha1)",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "ServiceSpec": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "description": "DNS-1123 label; also the `svc/<name>` segment of the pod's SPIFFE ID."
        },
        "namespace": {
          "type": "string"
        },
        "app_port": {
          "type": "integer",
          "format": "uint16",
          "minimum": 0,
          "maximum": 65535,
          "description": "Port the app container listens on (localhost), target of inbound service invocations."
        },
        "service_accounts": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?$"
          },
          "description": "Kubernetes service accounts whose pods may obtain this identity, besides `<service.name>`\n(default: `[<service.name>]`)."
        }
      },
      "required": [
        "name",
        "namespace",
        "app_port"
      ]
    },
    "MeshSpec": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "port": {
          "type": "integer",
          "format": "uint16",
          "minimum": 0,
          "maximum": 65535,
          "default": 50002
        },
        "peers": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "description": "peer (`<service>`, or `<service>.<namespace>` for another namespace, as the tools name it)\n→ `host:port` override of `<service>.<namespace>.svc.<cluster domain>:<port>`. The peer\nis still verified by its SPIFFE ID, whatever the address.",
          "default": {}
        }
      }
    },
    "SkillSpec": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "description": "DNS-1123 label, unique among skills.",
          "pattern": "^[a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?$"
        },
        "description": {
          "type": "string",
          "description": "What the skill is for (1 to 1024 characters); the model sees it before it loads the skill.",
          "minLength": 1,
          "maxLength": 1024
        },
        "instructions": {
          "type": "string",
          "description": "What the agent should do (1 to 32768 bytes).",
          "minLength": 1,
          "maxLength": 32768
        },
        "tools": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Tools the instructions use; each must be allowed for every agent that uses the skill."
        }
      },
      "required": [
        "name",
        "description",
        "instructions"
      ],
      "description": "A named set of instructions agents can use (`agents[].skills`)."
    },
    "AgentSpec": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "type": {
          "$ref": "#/$defs/AgentType",
          "default": "agent"
        },
        "model": {
          "type": "string",
          "description": "A Claude model id (e.g. `claude-opus-5-5`) or `mock`: not empty, no whitespace or control\ncharacters, at most 128 bytes.",
          "maxLength": 128,
          "pattern": "^[^\\s\\x00-\\x1f\\x7f-\\x9f]+$"
        },
        "system": {
          "type": "string",
          "description": "System prompt, at most 32768 bytes.",
          "maxLength": 32768,
          "default": ""
        },
        "tools": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ToolSpec"
          },
          "default": []
        },
        "budgets": {
          "$ref": "#/$defs/Budgets",
          "default": {
            "max_tokens_per_call": 1024,
            "max_calls_per_minute": 60,
            "max_cost_usd_per_day": 10.0,
            "max_steps": 8
          }
        },
        "skills": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?$"
          },
          "description": "Names of top-level `skills` this agent uses, each at most once.",
          "uniqueItems": true
        },
        "harness": {
          "anyOf": [
            {
              "$ref": "#/$defs/HarnessSpec"
            },
            {
              "type": "null"
            }
          ],
          "description": "Retries, timeouts and the fallback model. Absent = the defaults."
        },
        "learning": {
          "anyOf": [
            {
              "$ref": "#/$defs/LearningSpec"
            },
            {
              "type": "null"
            }
          ],
          "description": "Governed learning. Absent = off."
        },
        "practices": {
          "anyOf": [
            {
              "$ref": "#/$defs/PracticesSpec"
            },
            {
              "type": "null"
            }
          ],
          "description": "Working practices: plan, clarify, brevity (agent-practices design). Absent = the\ndefaults, all on."
        },
        "taint": {
          "anyOf": [
            {
              "$ref": "#/$defs/TaintSpec"
            },
            {
              "type": "null"
            }
          ],
          "description": "Taint-aware policy (docs/design/taint-policy.md). Absent = off."
        }
      },
      "required": [
        "name",
        "model"
      ]
    },
    "AgentType": {
      "type": "string",
      "enum": [
        "agent",
        "orchestrator"
      ]
    },
    "ToolSpec": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "description": "The name the model sees, unique per agent: `^[a-zA-Z0-9_-]{1,64}$`, and never\n`load_skill` or `ask_caller` (the runtime's own tools).",
          "pattern": "^[a-zA-Z0-9_-]{1,64}$",
          "not": {
            "enum": [
              "load_skill",
              "ask_caller"
            ]
          }
        },
        "description": {
          "type": "string"
        },
        "type": {
          "$ref": "#/$defs/ToolType"
        },
        "parameters": {
          "description": "JSON Schema object describing the tool input. Defaults per CONTRACT.md §3.1."
        },
        "service": {
          "type": [
            "string",
            "null"
          ],
          "description": "`service` tools: target service. `agent` tools: remote service (omit for local). A service\nof this charter's namespace is `<service>`; one in another namespace is\n`<service>.<namespace>` (charter schema level 5)."
        },
        "method": {
          "type": [
            "string",
            "null"
          ]
        },
        "path": {
          "type": [
            "string",
            "null"
          ]
        },
        "agent": {
          "type": [
            "string",
            "null"
          ]
        },
        "url": {
          "type": [
            "string",
            "null"
          ]
        },
        "label": {
          "anyOf": [
            {
              "$ref": "#/$defs/TaintLabel"
            },
            {
              "type": "null"
            }
          ],
          "description": "Label of what this tool returns (taint policy). Default: `untrusted` for `http` tools,\n`trusted` for `service` and `agent` tools."
        },
        "effect": {
          "anyOf": [
            {
              "$ref": "#/$defs/ToolEffect"
            },
            {
              "type": "null"
            }
          ],
          "description": "What the call does (taint policy). Default from the method: GET, HEAD and OPTIONS read,\neverything else writes; `agent` tools read (the callee's sidecar enforces its own policy)."
        },
        "approval": {
          "anyOf": [
            {
              "$ref": "#/$defs/ApprovalSpec"
            },
            {
              "type": "null"
            }
          ],
          "description": "A person must approve each call before it runs (schema level 7, CONTRACT.md §5.4). Absent\n= no approval."
        }
      },
      "required": [
        "name",
        "description",
        "type"
      ]
    },
    "ToolType": {
      "type": "string",
      "enum": [
        "service",
        "agent",
        "http"
      ]
    },
    "TaintLabel": {
      "oneOf": [
        {
          "type": "string",
          "const": "trusted",
          "description": "Data the service vouches for (its own records, the authenticated caller's request)."
        },
        {
          "type": "string",
          "const": "untrusted",
          "description": "Text a third party controls (emails, tickets, web pages, uploaded files): it may carry\ninstructions aimed at the model."
        },
        {
          "type": "string",
          "const": "sensitive",
          "description": "Data that must not leave the organisation (PII, account and health records)."
        }
      ],
      "description": "Where a run's data came from. A run carries every label it has read."
    },
    "ToolEffect": {
      "type": "string",
      "enum": [
        "read",
        "write"
      ],
      "description": "What a tool call does to the world."
    },
    "ApprovalSpec": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "timeout_s": {
          "type": "integer",
          "format": "uint32",
          "minimum": 1,
          "description": "Seconds a call waits for a decision before it is refused (`approval.expired`), 1 to\n86400; the run's own deadline may end the wait sooner.",
          "maximum": 86400,
          "default": 600
        }
      },
      "description": "`tools[].approval`: each call waits for a person's decision (CONTRACT.md §5.4)."
    },
    "Budgets": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_tokens_per_call": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0,
          "default": 1024
        },
        "max_calls_per_minute": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0,
          "default": 60
        },
        "max_cost_usd_per_day": {
          "type": "number",
          "format": "double",
          "default": 10.0
        },
        "max_steps": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0,
          "default": 8
        }
      }
    },
    "HarnessSpec": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_retries": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0,
          "description": "Retries of a model call after a retryable failure, 0..=10.",
          "maximum": 10,
          "default": 2
        },
        "request_timeout_seconds": {
          "type": "integer",
          "format": "uint32",
          "minimum": 1,
          "description": "SDK timeout of each attempt, 1..=600 seconds.",
          "maximum": 600,
          "default": 120
        },
        "fallback_model": {
          "type": [
            "string",
            "null"
          ],
          "description": "Model tried once after the last retryable failure; a valid model id other than `model`\n(the `model` rules: not empty, no whitespace or control characters, at most 128 bytes).",
          "maxLength": 128,
          "pattern": "^[^\\s\\x00-\\x1f\\x7f-\\x9f]+$"
        },
        "tool_result_max_chars": {
          "type": "integer",
          "format": "uint32",
          "minimum": 100,
          "description": "Tool results are cut to this many characters, 100..=200000.",
          "maximum": 200000,
          "default": 20000
        }
      },
      "description": "`agents[].harness`: how the runtime retries and bounds model and tool calls."
    },
    "LearningSpec": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": false
        },
        "mode": {
          "$ref": "#/$defs/LearningMode",
          "description": "`auto` requires `enabled: true`.",
          "default": "review"
        },
        "max_notes": {
          "type": "integer",
          "format": "uint32",
          "minimum": 1,
          "description": "Active notes kept for the agent, 1..=200.",
          "maximum": 200,
          "default": 20
        },
        "max_note_chars": {
          "type": "integer",
          "format": "uint32",
          "minimum": 50,
          "description": "Longest note, 50..=4000 characters.",
          "maximum": 4000,
          "default": 500
        },
        "note_ttl_days": {
          "type": "integer",
          "format": "uint32",
          "minimum": 1,
          "description": "Lifetime of an `auto` note, 1..=365 days.",
          "maximum": 365,
          "default": 7
        },
        "from_peers": {
          "type": "boolean",
          "description": "Also reflect on invocations whose caller is a peer service.",
          "default": false
        },
        "max_proposals_per_hour": {
          "type": "integer",
          "format": "uint32",
          "minimum": 1,
          "description": "Lessons the agent may propose per hour, 1..=100.",
          "maximum": 100,
          "default": 10
        },
        "require_evidence": {
          "type": [
            "boolean",
            "null"
          ],
          "description": "A lesson must cite the steps of the run it rests on (agent-practices design). Absent = true."
        },
        "contrast_runs": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0,
          "description": "Earlier runs the reflection sees as digests, 0..=20; 0 = none. Absent = 5.",
          "maximum": 20
        },
        "scopes": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "$ref": "#/$defs/LessonScope"
          },
          "description": "The lesson scopes that are kept, each at most once. Absent = `[invariant, domain]`.",
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "description": "`agents[].learning`: governed learning (design §4, §6.5).",
      "if": {
        "properties": {
          "mode": {
            "const": "auto"
          }
        },
        "required": [
          "mode"
        ]
      },
      "then": {
        "properties": {
          "enabled": {
            "const": true
          }
        },
        "required": [
          "enabled"
        ]
      }
    },
    "LearningMode": {
      "oneOf": [
        {
          "type": "string",
          "const": "review",
          "description": "A proposed lesson waits for an editor's decision."
        },
        {
          "type": "string",
          "const": "auto",
          "description": "A proposed lesson becomes a note at once and expires after `note_ttl_days`."
        }
      ]
    },
    "LessonScope": {
      "oneOf": [
        {
          "type": "string",
          "const": "invariant",
          "description": "How to work (planning, tool order, checking results, finishing); holds even if the\nsubject changes."
        },
        {
          "type": "string",
          "const": "domain",
          "description": "A procedure or constraint of the agent's subject."
        }
      ],
      "description": "What a lesson is about (agent-practices design, from Harness²)."
    },
    "PracticesSpec": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "plan": {
          "type": "boolean",
          "description": "Write a short plan before the first tool call and check each tool result against it.",
          "default": true
        },
        "clarify": {
          "$ref": "#/$defs/Clarify",
          "description": "When to ask the caller: `never`, `blocking` (a decision blocks the task) or `always`.",
          "default": "blocking"
        },
        "max_questions": {
          "type": "integer",
          "format": "uint32",
          "minimum": 1,
          "description": "Questions per round, 1..=10.",
          "maximum": 10,
          "default": 5
        },
        "brevity": {
          "$ref": "#/$defs/Brevity",
          "description": "How tersely the agent answers when the service's own app (or another local caller without\na calling agent) is the caller.",
          "default": "lite"
        },
        "agent_brevity": {
          "$ref": "#/$defs/Brevity",
          "description": "How tersely the agent answers when another agent is the caller.",
          "default": "full"
        },
        "auto_clarity": {
          "type": "boolean",
          "description": "Plain prose for security warnings, destructive or irreversible actions and ordered steps.",
          "default": true
        }
      },
      "description": "`agents[].practices` (agent-practices design): the working practices the runtime puts in\nfront of the model. Only switches and levels: the texts are fixed in the runtime, so these\nsettings cannot carry instructions."
    },
    "Clarify": {
      "oneOf": [
        {
          "type": "string",
          "const": "never",
          "description": "The agent never asks: no `ask_caller` tool and no clarify text."
        },
        {
          "type": "string",
          "const": "blocking",
          "description": "Only when a decision only the caller can make blocks the task and no safe default exists."
        },
        {
          "type": "string",
          "const": "always",
          "description": "Before acting on a request that leaves decisions open."
        }
      ],
      "description": "When the agent asks its caller for decisions (`practices.clarify`, the `ask_caller` tool)."
    },
    "Brevity": {
      "oneOf": [
        {
          "type": "string",
          "const": "normal",
          "description": "No output style: the answer is as the model writes it."
        },
        {
          "type": "string",
          "const": "lite",
          "description": "Terse, in full sentences."
        },
        {
          "type": "string",
          "const": "full",
          "description": "Terse, no articles; sentence fragments are fine."
        },
        {
          "type": "string",
          "const": "ultra",
          "description": "As terse as the meaning allows; each fact stated once."
        }
      ],
      "description": "How tersely the agent answers (`practices.brevity`, `practices.agent_brevity`)."
    },
    "TaintSpec": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "$ref": "#/$defs/TaintMode",
          "default": "enforce"
        },
        "input": {
          "$ref": "#/$defs/TaintLabel",
          "description": "Label of the invocation's own input. `trusted` (the default) for an authenticated\ncaller's request; `untrusted` when the input itself is third-party text.",
          "default": "trusted"
        }
      },
      "description": "Taint-aware policy of one agent: once a run has read untrusted data it may not call tools that\nwrite; once it has read sensitive data it may not call `http` tools (data leaving)."
    },
    "TaintMode": {
      "type": "string",
      "enum": [
        "enforce",
        "audit"
      ],
      "description": "`enforce` denies a call a rule forbids; `audit` allows it and records what would have been\ndenied (rule `taint.would_deny.<rule>`), for trying a policy on real traffic first."
    },
    "Guardrails": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_input_bytes": {
          "type": "integer",
          "format": "uint",
          "minimum": 0,
          "default": 16384
        },
        "pii_redact": {
          "type": "boolean",
          "default": false
        },
        "input_deny": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/RegexRule"
          },
          "default": []
        },
        "output_deny": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/RegexRule"
          },
          "default": []
        },
        "allowed_tools": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "description": "agent → tool names it may use (default: every tool it declares).",
          "default": {}
        },
        "allowed_services": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "description": "agent → services it may call (default: every service its tools name).",
          "default": {}
        }
      }
    },
    "RegexRule": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "regex": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "regex"
      ]
    },
    "Authz": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "default": {
          "$ref": "#/$defs/Decision",
          "default": "deny"
        },
        "callers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CallerRule"
          },
          "default": []
        },
        "services": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ServiceRule"
          },
          "default": []
        },
        "taint": {
          "anyOf": [
            {
              "$ref": "#/$defs/InboundTaintSpec"
            },
            {
              "type": "null"
            }
          ],
          "description": "The taint rule for inbound service calls (docs/design/taint-policy.md): a peer's call\nwhose run read untrusted data (its sidecar's `x-agentsc-taint`) may not write to this\nservice. Absent = off."
        }
      }
    },
    "Decision": {
      "type": "string",
      "enum": [
        "allow",
        "deny"
      ]
    },
    "CallerRule": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "identity": {
          "type": "string",
          "description": "`local` (the app container) or a SPIFFE ID."
        },
        "agents": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Agent names, or `\"*\"`."
        },
        "caller_agents": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Calling agents (the `x-agentsc-agent` claim of the caller's sidecar) this rule admits.\nEmpty = any calling agent, including a direct call by the caller's app."
        }
      },
      "required": [
        "identity",
        "agents"
      ]
    },
    "ServiceRule": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "identity": {
          "type": [
            "string",
            "null"
          ]
        },
        "agent": {
          "type": [
            "string",
            "null"
          ]
        },
        "service": {
          "type": "string",
          "description": "Target service (this service's own name when evaluated inbound)."
        },
        "allow": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "`\"<METHOD|*> <path>\"`, optional trailing `*` on the path.",
          "default": []
        },
        "deny": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        }
      },
      "required": [
        "name",
        "service"
      ]
    },
    "InboundTaintSpec": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "$ref": "#/$defs/TaintMode",
          "default": "enforce"
        }
      },
      "description": "`authz.taint`: `enforce` refuses a write (any method but GET, HEAD and OPTIONS) from a peer\nrun that read untrusted data; `audit` lets it through and records what it would refuse."
    },
    "AuditSpec": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sink": {
          "$ref": "#/$defs/AuditSink",
          "default": "stdout"
        },
        "file": {
          "type": [
            "string",
            "null"
          ]
        },
        "redact": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Dotted paths inside `input`/`output` replaced by \"[redacted]\".",
          "default": []
        }
      }
    },
    "AuditSink": {
      "type": "string",
      "enum": [
        "stdout",
        "file"
      ]
    },
    "TelemetrySpec": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "otlp_endpoint": {
          "type": [
            "string",
            "null"
          ],
          "description": "OTLP/HTTP endpoint, `http(s)://host[:port]` with no path, query or fragment. Honoured only\nwhen the sidecar allows it (`--otlp-endpoint-allow`); changing it needs a restart.",
          "pattern": "^https?://[^/?#@\\s\\x00-\\x1f\\x7f-\\x9f]+/?$"
        },
        "traces": {
          "type": "boolean",
          "default": true
        },
        "metrics": {
          "type": "boolean",
          "default": true
        },
        "export_payloads": {
          "type": "boolean",
          "description": "Spans carry inputs and outputs only if true.",
          "default": false
        },
        "control_plane_payloads": {
          "type": "boolean",
          "description": "Audit records sent to the control plane keep their (redacted, truncated) input/output.",
          "default": true
        }
      },
      "description": "`telemetry` (design §4, §9)."
    }
  },
  "$id": "https://agentsc.io/schemas/v1alpha1/charter.schema.json"
}
